import random

print("Welcome to Rock-Paper-Scissors!\n")
print("Winning Rules:")
print("Rock vs Paper -> Paper wins")
print("Rock vs Scissors -> Rock wins")
print("Paper vs Scissors -> Scissors wins\n")

choices = ["Rock", "Paper", "Scissors"]

while True:
    print("Choose the option.")
    print("1. Rock")
    print("2. Paper")
    print("3. Scissors")

    try:
        user_num = int(input("Enter your choice (1-3): "))
    except ValueError:
        print("Please enter a valid number.\n")
        continue

    while user_num < 1 or user_num > 3:
        try:
            user_num = int(input("Please enter a valid choice (1-3): "))
        except ValueError:
            print("Please enter a valid number.\n")
            continue

    user_choice = choices[user_num - 1]
    print("\nUser choice is:", user_choice)
    print("Now it's Computer's turn...")

    comp_num = random.randint(1, 3)
    comp_choice = choices[comp_num - 1]
    print("Computer choice is:", comp_choice)
    print(user_choice, "vs", comp_choice)

    # determine result
    if user_num == comp_num:
        print("<== It's a Tie! ==>")
    elif (
        (user_num == 1 and comp_num == 3) or
        (user_num == 2 and comp_num == 1) or
        (user_num == 3 and comp_num == 2)
    ):
        print("<== User wins! ==>")
    else:
        print("<== Computer wins! ==>")

    while True:
        ans = input("\nDo you want to play again? (Y/N): ").strip().lower()
        if ans in ['y', 'n']:
            break
        print("Please enter Y or N.")

    if ans == 'n':
        break

print("\nThanks for playing!")
